# SewaSathi environment variables
# Replace these placeholders with your real project keys.
# If left as placeholders (or blank), the app automatically falls back
# to local demo/mock data so the UI stays fully functional.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
